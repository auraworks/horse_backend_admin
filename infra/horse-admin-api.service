[Unit]
Description=Horse Admin API (FastAPI / uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/horse-admin/backend
EnvironmentFile=/etc/horse-admin.env
ExecStart=/opt/horse-admin/backend/.venv/bin/uvicorn src.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips '*' --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
