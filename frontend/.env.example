# Backend (FastAPI) base URL, called only from the Next.js server
BACKEND_API_URL=http://localhost:8000
# Must equal the backend's API_ACCESS_KEY. Never exposed to the browser.
API_ACCESS_KEY=change-me
# Admin login (defaults shown)
ADMIN_ID=admin
ADMIN_PASSWORD=123456789
# Random string used to sign the admin_session cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string
